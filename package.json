{
  "name": "ame-agent-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Agent (OpenCode) をリッチな UI で安全・低コスト運用する Windows / Linux / macOS 対応ローカル開発環境",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present --filter @ame-agent-chat/agent-core --filter @ame-agent-chat/frontend --filter @ame-agent-chat/gatekeeper test",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "docs:dev": "pnpm --filter @ame-agent-chat/docs dev",
    "docs:build": "pnpm --filter @ame-agent-chat/docs build",
    "docs:preview": "pnpm --filter @ame-agent-chat/docs preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
