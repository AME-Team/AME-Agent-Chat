# Agent Core (BFF) 環境変数 — コピーして .env へ
# OpenCode Server URL (コンテナ内同居: 40960) — 要件 #1 §2.4
OPENCODE_BASE_URL=http://localhost:40960
# Frontend (CORS 許可オリジン) — 要件 #1 §2.6
CORS_ORIGIN=http://localhost:51730
# Gatekeeper API (ホスト) — 要件 #1 §2.6 (87880 は TCP 上限超過のため 58780 で運用)
GATEKEEPER_URL=http://localhost:58780
# Agent Core ポート (既定 30010) — 要件 #1 §2.6
PORT=30010
# ログファイル出力先 (Issue #73) — 既定: OS 一時ディレクトリ配下の ame-agent-chat/agent-core.log
# LOG_FILE=/path/to/agent-core.log
# ログファイルのローテーション閾値 (bytes, 既定 1MB) — Issue #73
# LOG_MAX_SIZE=1048576
# ログダウンロード API の有効/無効 (Issue #73)
# ログにはリクエスト詳細や SDK 呼び出し内容が含まれ得る。API はターミナル API と同じ
# 共有トークン + Origin 検証を要求する。不要な環境では false を推奨。
# LOG_API_ENABLED=true
