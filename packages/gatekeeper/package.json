{
  "name": "@ame-agent-chat/gatekeeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "test": "node --import tsx --test scripts/startup.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts"
  },
  "dependencies": {
    "@ame-agent-chat/shared": "workspace:*",
    "hono": "^4.6.16",
    "@hono/node-server": "^1.13.7",
    "drizzle-orm": "^0.38.3",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
  }
}
